.masterDetailContainer {
  font-family: 'Segoe UI', -apple-system, BlinkMacSystemFont, Roboto, 'Helvetica Neue', sans-serif;
  color: #323130;
  padding: 20px;
  background: #ffffff;
  border-radius: 4px;
  box-shadow: 0 1.6px 3.6px 0 rgba(0,0,0,0.132), 0 0.3px 0.9px 0 rgba(0,0,0,0.108);

  .banner {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 24px;
    border-bottom: 2px solid #0078d4;
    padding-bottom: 12px;

    h1 {
      margin: 0;
      font-size: 22px;
      font-weight: 700;
      color: #201f1e;
      letter-spacing: -0.5px;
    }
  }

  .section {
    margin-bottom: 24px;

    .sectionHeader {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 8px;
      border-bottom: 1px solid #edebe9;
      padding-bottom: 4px;

      h3 {
        margin: 0;
        font-size: 16px;
        font-weight: 600;
        color: #0078d4;
        font-style: italic;
      }
    }
  }

  .idCardContainer {
    display: flex;
    gap: 20px;
    background: #faf9f8;
    padding: 16px;
    border-radius: 4px;
    border: 1px solid #edebe9;
    flex-wrap: wrap;

    .photoBox {
      width: 130px;
      height: 150px;
      background: #f3f2f1;
      border: 1px solid #c8c6c4;
      border-radius: 4px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      flex-shrink: 0;

      img {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }

      .placeholderIcon {
        font-size: 48px;
        color: #a19f9d;
      }

      .noPhotoText {
        font-size: 11px;
        color: #605e5c;
        margin-top: 4px;
      }
    }

    .detailGrid {
      flex: 1;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 12px;
      background: transparent;
      padding: 0;
      border: none;
    }
  }

  .detailGrid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 12px;
    background: #faf9f8;
    padding: 12px 16px;
    border-radius: 4px;
    border: 1px solid #edebe9;

    .detailItem {
      display: flex;
      flex-direction: column;

      .label {
        font-size: 12px;
        color: #605e5c;
        font-weight: 600;
        text-transform: uppercase;
        margin-bottom: 2px;
      }

      .value {
        font-size: 14px;
        color: #201f1e;
        font-weight: 500;
      }
    }
  }

  .actionButton {
    display: inline-flex;
    align-items: center;
    background: #0078d4;
    color: #ffffff !important;
    padding: 5px 12px;
    border-radius: 2px;
    text-decoration: none;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    border: none;
    transition: background 0.1s ease-in-out;

    &:hover {
      background: #106ebe;
    }
  }

  .secondaryButton {
    background: #ffffff;
    color: #0078d4 !important;
    border: 1px solid #0078d4;
    padding: 2px 8px;
    font-size: 12px;

    &:hover {
      background: #f3f2f1;
    }
  }

  .dataTable {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
    background: #ffffff;
    border: 1px solid #edebe9;

    th {
      background: #f3f2f1;
      text-align: left;
      padding: 8px 12px;
      font-weight: 600;
      border-bottom: 1px solid #e1dfdd;
      font-size: 13px;
    }

    td {
      padding: 8px 12px;
      border-bottom: 1px solid #edebe9;
      vertical-align: top;
    }

    tr:hover td {
      background: #f8f8f8;
    }
  }

  .emptyNotice {
    font-size: 13px;
    color: #605e5c;
    font-style: italic;
    padding: 8px 0;
  }
}
