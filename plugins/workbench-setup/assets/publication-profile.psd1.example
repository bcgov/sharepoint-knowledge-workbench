@{
    SchemaVersion = "1.0"

    Document = @{
        DocumentId        = "sample-manual"
        Title             = "Sample Technical Manual"
        ContentType       = "Manual"
        ContentOwner      = ""
        SourcePackagePath = "runs/sample-manual"
        PackageIdentity   = ""
    }

    HumanPublication = @{
        Enabled            = $true
        TargetType         = "DocumentLibrary"
        LibraryName        = "KnowledgePublications"
        RootFolder         = "sample-manual"
        TopicFolder        = "topics"
        MediaFolder        = "media"
        NavigationFolder   = "navigation"
        PublicationProfile = "multipage-markdown"
    }

    PagePublication = @{
        Enabled            = $false
        TargetType         = "SitePages"
        LibraryName        = "Site Pages"
        RootFolder         = "sample-manual"
        PageTemplate       = ""
        PageNamePattern    = "{TopicId}.aspx"
    }

    AgentGrounding = @{
        Enabled            = $true
        LibraryName        = "AgentGrounding"
        RootFolder         = "sample-manual"
        GroundingProfile   = "manual-grounding"
    }

    Agents = @(
        @{
            Enabled             = $true
            AgentId             = "knowledge-assistant"
            AgentName           = "Knowledge Assistant"
            AgentTemplate       = ""
            KnowledgeTargets    = @("HumanPublication")
            IncludeNativeSkills = $false
            Skills              = @()
        }
    )

    NativeSkills = @(
        # @{ SkillName = "review-manual-topics"; Approved = $true }
    )

    Evidence = @{
        OutputPath = "docs/reports/publications/sample-manual"
    }
}
