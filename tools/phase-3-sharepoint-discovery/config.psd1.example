# Copy this file to config.psd1 (same directory) and fill in real values.
# NEVER commit config.psd1 — it is gitignored via temp/-style rules is NOT
# sufficient here since this lives outside temp/; config.psd1 itself is
# explicitly gitignored (see repo .gitignore) and must stay that way.
@{
    # ============================================================
    # App registration used for interactive delegated login against the
    # target SharePoint site. Ask your tenant admin / IT for a registered
    # app with at least read access to the target site if you don't already
    # have one (e.g. Sites.Read.All delegated permission).
    # ============================================================
    ClientId = "00000000-0000-0000-0000-000000000000"
    TenantId = "00000000-0000-0000-0000-000000000000"

    # ============================================================
    # Target SharePoint site to run discovery against.
    # ============================================================
    SiteUrl  = "https://yourtenant.sharepoint.com/sites/YourSite"
}
