.DS_Store
~$*

# Per-phase git worktrees (superpowers:using-git-worktrees) — never committed.
.worktrees/

# Installed skill copies — regenerable from plugin-sources.json via the documented install
# command in CLAUDE.md. Not committing these is the point of this repo: prove that a fresh
# clone + the install command reproduces a working skill setup, not a vendored snapshot.
.agents/
.claude/

# Local scratch/session context, not part of the demonstrated setup.
context/

temp/
#docs/superpowers/

# Real tenant credentials for the Phase 3.0 SharePoint discovery tool — never commit.
# config.psd1.example (the template) IS committed; only the real, filled-in file is ignored.
tools/phase-3-sharepoint-discovery/config.psd1

# Real tenant credentials for the Phase 4.0 SharePoint native skills pilot tool — never commit.
# config.psd1.example (the template) IS committed; only the real, filled-in file is ignored.
tools/phase-4-native-sharepoint-skills/config.psd1

# Real tenant credentials for the Phase 5 CEIS grounding prototype — never commit.
# config.psd1.example (the template) IS committed; only the real, filled-in file is ignored.
tools/phase-5-sharepoint-knowledge-agent-pilot/config.psd1

# Real tenant credentials for the Phase 6 native-sharepoint evaluation runbook execution —
# never commit. config.psd1.example (the template) IS committed; only the real, filled-in
# file is ignored.
tools/phase-6-native-execution/config.psd1

# Raw tenant backup snapshots (agent/skill JSON+Markdown pulled from AG-CSB-INTRANET-DEV) —
# local-only reference copies, not authored content; regenerate via backup-existing-agents.ps1 /
# backup-skills-and-templates.ps1 rather than committing.
tools/phase-5-sharepoint-knowledge-agent-pilot/backups/


# Superpowers transient working state
.superpowers/
**/.superpowers/

# Python bytecode and cache
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.so
.pytest_cache/
**/.pytest_cache/

# Python packaging build output (contracts/python/, runtime/python/, and future plugin
# distributions per Phase 4.5's src/-layout pyproject.toml packages) — regenerable via
# `pip install -e .`/`python -m build`, never committed. Throwaway venvs created during
# development (.venv-*) are removed manually before each commit per the Phase 4.5 plan.
build/
*.egg-info/
.venv-*/
